# Port the node listens on
PORT=8787
HOST=0.0.0.0
# SQLite file. One file is the whole node; back it up and you have everything.
BARC_DB=./barc.db
# What members see when they connect
BARC_NODE_NAME=My Town Rides
BARC_NODE_DESCRIPTION=Driver-owned rides for our town. Run by us, for us.
# Default currency for fares (ISO 4217)
BARC_CURRENCY=ZAR
