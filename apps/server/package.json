{
  "name": "@barc/server",
  "version": "0.1.0",
  "private": true,
  "description": "BARC coordination node — a small, self-hostable server any community can run.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --watch --experimental-strip-types --no-warnings=ExperimentalWarning src/index.ts",
    "start": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning test/*.test.ts",
    "seed": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/seed.ts"
  },
  "dependencies": {
    "@barc/shared": "*",
    "@fastify/cors": "^11.0.0",
    "@fastify/websocket": "^11.0.0",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.0",
    "typescript": "~5.9.0"
  }
}
