# Copy to .env and fill in. Everything is optional; the defaults run a demo.
PORT=4300
APP_URL=http://localhost:4300
DB_PATH=data/platform.db

# Claude. Without a key the platform runs in demo mode with simulated responses.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
MAX_CONCURRENT_TASKS=2
# MOCK_CLAUDE=1 forces demo mode even when a key is set.

# Stripe. Without these, "Buy credits" tops up the wallet directly (dev only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Enables GET /api/admin/summary and /admin.html
ADMIN_TOKEN=
