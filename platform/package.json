{
  "name": "claude-task-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Prepaid task platform: clients buy credits, submit tasks, Claude does the work, usage is metered.",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types --no-warnings=ExperimentalWarning src/index.ts",
    "start": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning test/*.test.ts",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.6.0",
    "stripe": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.0"
  }
}
